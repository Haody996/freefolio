DATABASE_URL="postgresql://user:pass@localhost:5432/freefolio"
JWT_SECRET="change-me-to-a-long-random-string"
REDIS_URL="redis://localhost:6379"
CLIENT_URL="http://localhost:5173"
PORT=3001
NODE_ENV=development

# Google OAuth (console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Market data — stock/ETF quotes (finnhub.io → free API key)
FINNHUB_API_KEY="your-finnhub-api-key"
# Crypto quotes use CoinGecko's public API (no key required by default)
COINGECKO_API_BASE="https://api.coingecko.com/api/v3"

# How often the price-refresh worker pulls fresh quotes (minutes)
PRICE_REFRESH_INTERVAL_MIN=15
