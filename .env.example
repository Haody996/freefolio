DATABASE_URL="postgresql://user:pass@localhost:5432/freefolio"
JWT_SECRET="change-me-to-a-long-random-string"
REDIS_URL="redis://localhost:6379"
CLIENT_URL="http://localhost:5173"
PORT=3001
NODE_ENV=development

# Google OAuth (console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Market data needs NO API key: stocks/ETFs via Yahoo Finance, crypto via CoinGecko.
COINGECKO_API_BASE="https://api.coingecko.com/api/v3"

# How often the price-refresh worker pulls fresh quotes (minutes)
PRICE_REFRESH_INTERVAL_MIN=15

# Comma-separated emails auto-granted admin access
ADMIN_EMAILS=""

# AI daily insights (Google Gemini)
GEMINI_API_KEY=""

# Email digest (weekly/monthly). Leave SMTP_HOST empty to disable sending.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="digest@getfreefolio.com"
