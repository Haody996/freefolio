generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Auth / user ─────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  profile         Profile?
  holdings        Holding[]
  netWorthHistory NetWorthSnapshot[]
  projection      ProjectionSettings?
}

model Profile {
  id        String  @id @default(cuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String  @default("")
  lastName  String  @default("")
}

// ─── Holdings ────────────────────────────────────────────────────────
// The design treats everything as a flat, categorized holding. Value is
// quantity × price; the day change is (price − prevClose) × quantity.
// Cash / Other are manual entries (quantity 1, price = total value).

enum Category {
  STOCKS
  CRYPTO
  CASH
  BONDS
  OTHER
}

model Holding {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  name      String
  category  Category @default(STOCKS)
  quantity  Float    @default(0)
  price     Float    @default(0)
  prevClose Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol])
  @@index([userId])
  @@index([symbol])
}

// ─── Net-worth history ───────────────────────────────────────────────
// One row per user per day (assets only — the design has no liabilities).

model NetWorthSnapshot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  netWorth  Float
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

// ─── Compound-growth projection settings ─────────────────────────────
// The projection math runs client-side from these inputs; we persist them
// so the sliders keep their positions across sessions. startingCapital
// null → default to the user's current net worth.

model ProjectionSettings {
  id                 String @id @default(cuid())
  userId             String @unique
  user               User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  startingCapital    Float?
  monthlyContribution Float @default(3000)
  expectedReturnPct  Float  @default(8)
  years              Int    @default(25)
  inflationPct       Float  @default(3)

  updatedAt DateTime @updatedAt
}
