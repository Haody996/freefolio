generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Auth / user ─────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  profile         Profile?
  holdings        Holding[]
  netWorthHistory NetWorthSnapshot[]
  projection      ProjectionSettings?
  transactions    Transaction[]
  liabilities     Liability[]

  // Email digest (net-worth change, top movers, FIRE progress). Opt-in.
  digestFrequency DigestFrequency @default(OFF)
  lastDigestAt    DateTime?
}

model Profile {
  id        String  @id @default(cuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String  @default("")
  lastName  String  @default("")
}

// ─── Holdings ────────────────────────────────────────────────────────
// The design treats everything as a flat, categorized holding. Value is
// quantity × price; the day change is (price − prevClose) × quantity.
// Cash / Other are manual entries (quantity 1, price = total value).

enum Category {
  STOCKS
  CRYPTO
  CASH
  BONDS
  OTHER
  METALS      // gold/silver/platinum/palladium — quantity in troy oz, priced per oz
  REAL_ESTATE // manual value, or estimated from purchase price × appreciation
  VEHICLE     // manual value, or estimated from purchase price × depreciation
}

// The account a holding lives in. Determines its tax treatment (see client
// portfolio.ts for the account → pre-tax / Roth / taxable mapping).
enum AccountType {
  TAXABLE
  TRADITIONAL_401K
  ROTH_401K
  TRADITIONAL_IRA
  ROTH_IRA
  HSA
  OTHER
}

// Recurring auto-invest (DCA) cadence.
enum AutoFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
}

// Retirement drawdown strategy.
enum WithdrawalStrategy {
  FIXED
  GUARDRAILS
}

enum TxType {
  BUY
  SELL
}

// Where a transaction came from: logged by hand, added via "Add holding" on an
// existing position, or applied by the auto-invest worker.
enum TxSource {
  MANUAL
  ADD
  AUTO_INVEST
}

enum LiabilityType {
  MORTGAGE
  HELOC
  AUTO_LOAN
  STUDENT_LOAN
  CREDIT_CARD
  PERSONAL_LOAN
  MEDICAL
  OTHER
}

enum DebtStrategy {
  AVALANCHE // highest interest rate first
  SNOWBALL  // smallest balance first
}

enum DigestFrequency {
  OFF
  WEEKLY
  MONTHLY
}

model Holding {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  name        String
  category    Category    @default(STOCKS)
  accountType AccountType @default(TAXABLE)
  institution String      @default("") // free-form brokerage (Schwab, Fidelity…)
  quantity    Float       @default(0)
  price       Float       @default(0)
  prevClose   Float       @default(0)

  // Recurring auto-invest: add $autoAmount of this holding every period. The
  // auto-invest worker converts the dollar amount to shares at the current price.
  autoAmount    Float?
  autoFrequency AutoFrequency?
  autoNextAt    DateTime?
  autoLastAt    DateTime?

  // Cost basis for shares not covered by logged BUY transactions (the "opening
  // lot"): average cost per unit and approximate acquisition date. Null cost →
  // basis unknown. For real estate / vehicles these are the purchase price/date.
  openingCostPerShare Float?
  openingAcquiredAt   DateTime?

  // Provider-specific market id when the ticker alone is ambiguous (CoinGecko
  // coin id for crypto, e.g. PEPE → "pepe").
  providerId String?

  // Real estate / vehicles: annual appreciation % (negative = depreciation).
  // Non-null → value is estimated from openingCostPerShare + openingAcquiredAt.
  appreciationPct Float?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Same ticker can live in different accounts AND institutions (e.g. VTI in
  // taxable at Schwab + Roth IRA at Fidelity), so uniqueness spans both.
  transactions Transaction[]
  liabilities  Liability[] // debts secured by this asset (mortgage → house)

  @@unique([userId, symbol, accountType, institution])
  @@index([userId])
  @@index([symbol])
}

// A buy/sell logged against a holding. Applying it adjusts the holding's share
// quantity and (optionally) a cash holding's balance.
model Transaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdingId    String
  holding      Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  type         TxType
  quantity     Float
  price        Float
  amount       Float // quantity × price
  date         DateTime @default(now())
  affectedCash Boolean  @default(false)
  cashHoldingId String?
  source       TxSource @default(MANUAL)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([holdingId])
}

// ─── Liabilities ─────────────────────────────────────────────────────
// Debts subtract from net worth. minPayment is the required monthly payment
// (principal + interest). An optional secured asset (house, car) lets the UI
// show equity.

model Liability {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  type            LiabilityType @default(OTHER)
  institution     String        @default("")
  balance         Float         @default(0)
  interestRatePct Float         @default(0) // APR
  minPayment      Float         @default(0) // monthly
  holdingId       String?
  holding         Holding?      @relation(fields: [holdingId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
}

// ─── Net-worth history ───────────────────────────────────────────────
// One row per user per day: assets − liabilities.

model NetWorthSnapshot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  netWorth  Float
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

// ─── Compound-growth projection settings ─────────────────────────────
// The projection math runs client-side from these inputs; we persist them
// so the sliders keep their positions across sessions. startingCapital
// null → default to the user's current net worth.

model ProjectionSettings {
  id                  String @id @default(cuid())
  userId              String @unique
  user                User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Savings / growth
  startingCapital     Float? // null → default to current net worth
  monthlyContribution Float  @default(3000)
  expectedReturnPct   Float  @default(8)
  inflationPct        Float  @default(3)
  years               Int    @default(25) // legacy (unused by the retirement sim)

  // Ages
  currentAge          Int    @default(30)
  retirementAge       Int    @default(55)
  endAge              Int    @default(95) // plan-to age

  // Retirement spending (today's dollars)
  annualSpending      Float  @default(60000)
  vacationBudget      Float  @default(12000) // extra annual spend early in retirement
  vacationYears       Int    @default(10)
  taxRatePct          Float  @default(15)

  // Guaranteed income (socialSecurityAnnual = benefit at full retirement age 67)
  socialSecurityAnnual Float @default(24000)
  ssStartAge           Int   @default(67)
  pensionAnnual        Float @default(0)
  pensionStartAge      Int   @default(65)

  // Strategy & fees
  aumFeePct          Float             @default(0)     // advisory / fund fee, reduces return
  withdrawalStrategy WithdrawalStrategy @default(FIXED) // FIXED vs Guyton-Klinger GUARDRAILS
  spendingSmile      Boolean           @default(false) // real spending declines through retirement
  applyRmd           Boolean           @default(true)  // required minimum distributions at 73+
  healthcareAnnual       Float @default(6000) // separate expense line
  healthcareInflationPct Float @default(5)     // grows faster than general inflation

  // FIRE goal for the sidebar progress bar (null → default to projected nest egg)
  fireGoal Float?

  // Debt payoff plan — also feeds debt payments into the retirement sim.
  debtStrategy         DebtStrategy @default(AVALANCHE)
  debtExtraPayment     Float        @default(0)    // extra $/mo on top of minimums
  redirectDebtPayments Boolean      @default(true) // paid-off payments → savings

  updatedAt DateTime @updatedAt
}
